{{- $entries := slice -}}
{{- range site.RegularPages -}}
  {{- $excluded := eq (lower (printf "%v" .Params.search)) "false" -}}
  {{- $searchPage := or (eq .Type "search") (eq .Section "search") (eq .Layout "search") -}}
  {{- with .File -}}
    {{- $searchPage = or $searchPage (eq .TranslationBaseName "search") -}}
  {{- end -}}
  {{- if or $excluded $searchPage -}}
    {{- continue -}}
  {{- end -}}

  {{- $image := "" -}}
  {{- with .Params.image -}}
    {{- with resources.Get .src -}}
      {{- $image = (.Resize "240x webp q80").RelPermalink -}}
    {{- end -}}
  {{- end -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "permalink" (.RelPermalink | default "/")
    "contents" (partial "search-content.html" .)
    "image" $image
    "tags" (.Params.tags | default slice)
    "categories" (.Params.categories | default slice)
  ) -}}
{{- end -}}
{{- $entries | jsonify -}}
